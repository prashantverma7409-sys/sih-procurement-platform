generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      String   // "STARTUP" or "OFFICER"
  email     String   @unique
  createdAt DateTime @default(now())
}

model Tender {
  id               String   @id @default(cuid())
  department       String
  title            String
  rawText          String
  tldr             String
  budget           String
  timelineDays     Int
  emdRequired      Boolean
  aiSanitized      Boolean  @default(true)
  matchPercentage  Int      @default(0)
  createdAt        DateTime @default(now())
}

model Proposal {
  id        String   @id @default(cuid())
  tenderId  String
  startupId String
  status    String   // "SUBMITTED", "EVALUATING", "PILOT", "REJECTED"
  createdAt DateTime @default(now())
}
